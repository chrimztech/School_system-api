# Copy this file to .env.production (or set these as real environment
# variables / secrets in your hosting platform) and fill in real values.
# NEVER commit a file with real secrets — .gitignore already excludes
# .env and .env.* (except this .example file).
#
# Then run with:  SPRING_PROFILES_ACTIVE=production java -jar srms-api.jar

# --- Required: Database ---
# Full JDBC URL — convert postgres://user:pass@host:5432/db to jdbc:postgresql://host:5432/db
# is correct here — Postgres itself only listens on loopback, it is not exposed on the network.
DATABASE_URL=jdbc:postgresql://localhost:5432/school_system
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me-to-a-real-password

# --- Required: JWT signing secret ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-256-bit-secret

# --- Required: CORS ---
# Your deployed frontend origin(s), comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://school.edu.zm

# --- Required: System admin bootstrap (first boot only) ---
APP_ADMIN_EMAIL=admin@yourschool.com
APP_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Optional: server port (some platforms inject PORT automatically) ---
PORT=8080

# --- Optional: database connection pool tuning ---
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000

# --- Optional: JWT expiration override (ms). Default 86400000 = 24h ---
# JWT_EXPIRATION_MS=86400000

# --- Optional: Email (SMTP) — leave unset to disable the email channel ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourschool.com

# --- Optional: Zamtel BulkSMS — leave ZAMTEL_BULKSMS_API_KEY unset to disable the SMS channel ---
ZAMTEL_BULKSMS_BASE_URL=https://bulksms.zamtel.co.zm/api
ZAMTEL_BULKSMS_API_KEY=zbsms_Il5TZZyIUbaBe7oZ
ZAMTEL_BULKSMS_SENDER_ID=DCL

# --- Required: ZynlePay payment gateway (card payments) ---
# From the ZynlePay merchant dashboard. Card payments are disabled until these are set.
ZYNLEPAY_MERCHANT_ID=
ZYNLEPAY_API_ID=
ZYNLEPAY_API_KEY=
# --- Optional: override if ZynlePay gives you different endpoints ---
# ZYNLEPAY_BASE_URL=https://payments.zynlepay.com/zynlepay/jsonapi/
# ZYNLEPAY_PAYMENT_STATUS_URL=https://payments.zynlepay.com/zynlepay/paymentstatus

# ============================================================================
# Scaling horizontally (running more than one backend instance behind a load
# balancer, once one instance's throughput is no longer enough)
# ============================================================================
# The app is built to support this without code changes to auth/session handling —
# JWT auth is stateless (no server-side session store to keep in sync across
# instances) — but two things below need attention when you actually do it:
#
# 1. DB_POOL_SIZE is PER INSTANCE. 4 instances at the default DB_POOL_SIZE=20 means
#    up to 80 concurrent connections against Postgres, not 20 — check that against
#    your database plan's max_connections and lower DB_POOL_SIZE per instance if
#    you're running many of them, rather than raising max_connections indefinitely.
#
# 2. The grading-bands/grade-weights cache (see CacheConfig.java) is in-process
#    (Caffeine), not shared — each instance has its own copy. A school admin's
#    settings change is only evicted from the instance that handled that request;
#    other instances keep serving their own cached copy for up to its 10-minute
#    TTL. Harmless for how this app runs today (one instance), but once you're
#    running more than one, swap CacheConfig's CacheManager bean for a Redis-backed
#    one (spring-boot-starter-data-redis + RedisCacheManager) so a write on any
#    instance evicts the value everywhere — the @Cacheable/@CacheEvict call sites
#    themselves don't need to change.
#
# Nothing else needs a lock or coordination between instances: the nightly backup
# cron (BackupService) and the payment-reconciliation poll (PaymentGatewayService)
# are both already safe to run redundantly across instances — see the comments on
# each @Scheduled method for why.
